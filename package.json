{
  "name": "agent-platform-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tickets": "node tools/copy_tickets.mjs",
    "predev": "node tools/copy_tickets.mjs",
    "dev": "vite --port 4310 --strictPort",
    "prebuild": "node tools/copy_tickets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4311 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "shots": "node tools/shots.mjs",
    "deploy": "bash tools/deploy.sh"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
